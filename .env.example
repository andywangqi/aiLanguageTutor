NEXT_PUBLIC_SITE_URL=https://ailanguagetutor.online

# Microsoft Clarity project ID for website analytics.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Umami website analytics. Leave blank to disable; use the script URL and
# Website ID shown in your Umami website tracking code.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Public central API configuration. The write key is safe for browser analytics only.
NEXT_PUBLIC_ZHYADMIN_ENDPOINT=https://zhyadmin.vercel.app
NEXT_PUBLIC_ZHYADMIN_WRITE_KEY=

# Supabase Auth project used by the product.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Supabase service-role, OpenAI, storage, and Waffo credentials belong on the
# central zhyadmin backend, never on this website.
