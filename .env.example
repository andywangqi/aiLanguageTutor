NEXT_PUBLIC_SITE_URL=https://ailanguagetutor.online

# Public central API configuration. The write key is safe for browser analytics only.
NEXT_PUBLIC_ZHYADMIN_ENDPOINT=https://zhyadmin.vercel.app
NEXT_PUBLIC_ZHYADMIN_WRITE_KEY=

# Server-only central API credential. Never expose this to client code.
ZHYADMIN_SERVER_KEY=

# Supabase Auth / database project used by the product.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider configuration. Qwen is the default tutor engine.
# Use Alibaba Cloud Model Studio / DashScope OpenAI-compatible mode.
PRODUCT_API_BACKEND=local
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional private Supabase Storage bucket for uploaded voice clips.
SUPABASE_VOICE_BUCKET=voice-inputs

# Server-only Waffo configuration. Fill these after the official merchant contract is confirmed.
WAFFO_API_BASE_URL=
WAFFO_API_KEY=
WAFFO_API_SECRET=
WAFFO_WEBHOOK_PUBLIC_KEY=
